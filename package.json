{
  "name": "@anaylab/canvas-mcp",
  "version": "1.2.0",
  "description": "MCP server that connects Claude to Canvas LMS - manage coursework through natural conversation",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "dev": "tsc --watch",
    "test": "npm run build && node --test test/*.test.mjs",
    "demo": "npm run build && node dist/demo/index.js",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "mcp",
    "canvas",
    "lms",
    "claude",
    "ai",
    "education",
    "university",
    "assignments",
    "model-context-protocol"
  ],
  "author": "anaylab",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/anaylab/canvas-mcp.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3"
  },
  "bin": {
    "canvas-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "optionalDependencies": {
    "unpdf": "^1.8.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://anaylab.github.io/canvas-mcp/",
  "bugs": {
    "url": "https://github.com/anaylab/canvas-mcp/issues"
  }
}
